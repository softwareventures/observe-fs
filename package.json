{
  "private": true,
  "name": "@softwareventures/observe-fs",
  "version": "0.0.0-development",
  "description": "",
  "keywords": [],
  "author": "Daniel Cassidy <mail@danielcassidy.me.uk>",
  "homepage": "https://github.com/softwareventures/observe-fs",
  "bugs": "https://github.com/softwareventures/observe-fs/issues",
  "repository": "github:softwareventures/observe-fs",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "commit": "cz",
    "fix": "tsc --noEmit && eslint . --fix && prettier --write .",
    "postinstall": "husky",
    "lint": "tsc --noEmit && eslint . && prettier --check .",
    "prepack": "tsc",
    "test": "ava"
  },
  "sideEffects": false,
  "exports": {
    ".": "./index.js"
  },
  "engines": {
    "node": "^20 || ^22 || ^24 || >=25"
  },
  "dependencies": {
    "@types/node": ">=20.0.0",
    "rxjs": "^6.0.0 || ^7.0.0",
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "@commitlint/cli": "20.4.3",
    "@commitlint/config-conventional": "20.4.3",
    "@commitlint/cz-commitlint": "20.4.3",
    "@eslint/js": "9.39.4",
    "@softwareventures/array": "7.0.1",
    "@softwareventures/eslint-config": "10.0.0-alpha.2",
    "@softwareventures/precise-commits": "4.0.23",
    "@softwareventures/prettier-config": "4.0.0",
    "@softwareventures/tsconfig": "8.1.1",
    "@typescript-eslint/eslint-plugin": "8.56.1",
    "@typescript-eslint/parser": "8.56.1",
    "ava": "7.0.0",
    "commitizen": "4.3.1",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "62.7.1",
    "eslint-plugin-prefer-arrow": "1.2.3",
    "eslint-plugin-sonarjs": "4.0.1",
    "husky": "9.1.7",
    "inquirer": "9.3.7",
    "prettier": "3.4.2",
    "tempy": "3.1.0",
    "tsimp": "2.0.12",
    "typescript": "5.7.2"
  },
  "eslintConfig": {
    "root": true,
    "extends": "@softwareventures"
  },
  "prettier": "@softwareventures/prettier-config",
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "ava": {
    "concurrency": 1,
    "extensions": {
      "ts": "module"
    },
    "nodeArguments": [
      "--import=tsimp/import"
    ],
    "timeout": "40s"
  },
  "release": {
    "extends": "@softwareventures/semantic-release-config"
  },
  "packageManager": "yarn@4.5.3"
}
